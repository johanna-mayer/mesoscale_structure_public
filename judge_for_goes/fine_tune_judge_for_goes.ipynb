    "class GOESLabeledDataset(Dataset):\n",
    "    \"\"\"Dataset for manually labeled GOES images stored in netCDF format\"\"\"\n",
    "    def __init__(self, labeled_netcdf_path):\n",
    "        self.netcdf_path = labeled_netcdf_path\n",
    "        \n",
    "        # Load the netCDF dataset\n",
    "        with xr.open_dataset(labeled_netcdf_path) as ds:\n",
    "            # Load data into memory to avoid file access issues\n",
    "            self.images = ds.image_data.values  # Shape: (n_samples, 4, 128, 128)\n",
    "            self.labels = ds.label.values       # Shape: (n_samples,)\n",
    "            self.metadata = {\n",
    "                'unique_ids': ds.unique_id.values,\n",
    "                'datetimes': ds.datetime.values,\n",
    "                'lat_mid': ds.lat_mid.values,\n",
    "                'lon_mid': ds.lon_mid.values,\n",
    "                'class_names': ds.class_name.values\n",
    "            }\n",
    "        \n",
    "        print(f\"Loaded {len(self.images)} samples from {labeled_netcdf_path}\")\n",
    "        \n",
    "    def __len__(self):\n",
    "        return len(self.images)\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        image = self.images[idx] # Shape: (4, 128, 128)\n",
    "        label = self.labels[idx]\n",
    "        \n",
    "        # Debug checks\n",
    "        if np.isnan(image).any():\n",
    "            print(f\"NaN found in image {idx}\")\n",
    "        if np.isinf(image).any():\n",
    "            print(f\"Inf found in image {idx}\")\n",
    "        \n",
    "        return torch.FloatTensor(image), torch.LongTensor([label]).squeeze()\n",
    "    \n",
    "    def get_sample_info(self, idx):\n",
    "        \"\"\"Get metadata for a specific sample\"\"\"\n",
    "        return {\n",
    "            'unique_id': self.metadata['unique_ids'][idx],\n",
    "            'datetime': self.metadata['datetimes'][idx],\n",
    "            'lat_mid': self.metadata['lat_mid'][idx],\n",
    "            'lon_mid': self.metadata['lon_mid'][idx],\n",
    "            'class_name': self.metadata['class_names'][idx]\n",
    "        }\n",
    "    \n",
    "    def get_class_distribution(self):\n",
    "        \"\"\"Get the distribution of classes in the dataset\"\"\"\n",
    "        class_names = ['Solid stratus', 'Closed MCC', 'Open MCC', 'Disorganized MCC', 'Clustered Cu', 'Suppressed Cu']\n",
    "        \n",
    "        print(\"Class distribution:\")\n",
    "        print(\"-\" * 40)\n",
    "        for class_idx in range(6):\n",
    "            count = (self.labels == class_idx).sum()\n",
    "            percentage = 100 * count / len(self.labels)\n",
    "            print(f\"{class_names[class_idx]}: {count} ({percentage:.1f}%)\")\n",
    "        \n",
    "        return {class_idx: (self.labels == class_idx).sum() for class_idx in range(6)}\n",
    "\n",
    "def visualize_labeled_data(netcdf_path, num_samples=5):\n",
    "    \"\"\"Visualize some labeled samples from the netCDF file\"\"\"\n",
    "    with xr.open_dataset(netcdf_path) as ds:\n",
    "        n_samples = min(num_samples, len(ds.sample))\n",
    "        \n",
    "        fig, axes = plt.subplots(n_samples, 3, figsize=(16, 4*n_samples))\n",
    "        if n_samples == 1:\n",
    "            axes = axes.reshape(1, -1)\n",
    "            \n",
    "        class_names = ['Solid stratus', 'Closed MCC', 'Open MCC', 'Disorganized MCC', 'Clustered Cu', 'Suppressed Cu']\n",
    "        \n",
    "        for i in range(n_samples):\n",
    "            image = ds.image_data[i].values\n",
    "            label = ds.label[i].item()\n",
    "            class_name = class_names[int(label)]\n",
    "            datetime_str = pd.to_datetime(ds.datetime[i].values).strftime('%Y-%m-%d %H:%M')\n",
    "            lat = ds.lat_mid[i].item()\n",
    "            lon = ds.lon_mid[i].item()\n",
    "            \n",
    "            # COD channel\n",
    "            axes[i, 0].imshow(image[3], vmax=1, cmap='Greys_r')\n",
    "            axes[i, 0].set_title('COD Channel')\n",
    "            axes[i, 0].axis('off')\n",
    "            \n",
    "            # BT channel\n",
    "            axes[i, 1].imshow(image[2], vmax=1, cmap='Greys')\n",
    "            axes[i, 1].set_title('BT Ch14')\n",
    "            axes[i, 1].axis('off')\n",
    "            \n",
    "            # RGB composite\n",
    "            rgb_image = np.zeros((128, 128, 3))\n",
    "            for j in range(3):\n",
    "                rgb_image[:, :, j] = image[j]\n",
    "            axes[i, 2].imshow(rgb_image)\n",
    "            axes[i, 2].set_title('RGB Composite')\n",
    "            axes[i, 2].axis('off')\n",
    "            \n",
    "            # Add title with info\n",
    "            title = f\"Sample {i}: {label} {class_name}\\n{datetime_str}, Lat {lat:.1f}°, Lon {lon:.1f}°\"\n",
    "            axes[i, 0].text(-10, 64, title, rotation=90, ha='right', va='center', fontsize=10)\n",
    "            \n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "        # Print summary statistics\n",
    "        print(f\"\\nDataset summary:\")\n",
    "        print(f\"Total samples: {len(ds.sample)}\")\n",
    "        print(f\"Class distribution:\")\n",
    "        for class_idx, class_name in enumerate(class_names):\n",
    "            count = (ds.label.values == class_idx).sum()\n",
    "            percentage = 100 * count / len(ds.sample)\n",
    "            print(f\"  {class_name}: {count} ({percentage:.1f}%)\")"
