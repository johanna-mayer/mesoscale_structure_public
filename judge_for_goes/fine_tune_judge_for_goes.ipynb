    "# Replace your matplotlib setup with:\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')  # Use non-interactive backend\n",
    "%matplotlib inline\n",
    "import json\n",
    "\n",
    "# Then use the simplified non-interactive labeler\n",
    "class SimpleGOESLabeler:\n",
    "    def __init__(self, image_data, scene_params, datetime, cod, class_names, save_path='labeled_goes_data.nc'):\n",
    "        self.image_data = image_data\n",
    "        self.scene_params = scene_params\n",
    "        self.datetime = datetime\n",
    "        self.cod = cod\n",
    "        self.class_names = class_names\n",
    "        self.save_path = save_path\n",
    "        self.results = []  # List to store labeled data\n",
    "        self.load_existing_unique_ids()\n",
    "        self.unique_id = self.create_unique_id()\n",
    "        \n",
    "    def load_existing_unique_ids(self):\n",
    "        \"\"\"Load existing labels from netCDF file\"\"\"\n",
    "        if os.path.exists(self.save_path):\n",
    "            with xr.open_dataset(self.save_path) as ds:\n",
    "                self.existing_unique_ids = ds.unique_id.values\n",
    "        else:\n",
    "            self.existing_unique_ids = None\n",
    "\n",
    "    def create_unique_id(self):\n",
    "        \"\"\"Create a unique identifier for the current sample\"\"\"\n",
    "        uid = (f\"{pd.to_datetime(self.datetime).strftime('%Y%m%d%H%M')}_\"\n",
    "               f\"{self.scene_params['y_idx']}_\"\n",
    "               f\"{self.scene_params['x_idx']}\")\n",
    "        return uid\n",
    "\n",
    "    def check_if_already_labeled(self):\n",
    "        \"\"\"Check if a sample with the given unique_id has already been labeled\"\"\"\n",
    "        if self.existing_unique_ids is None:\n",
    "            return False\n",
    "        return self.unique_id in self.existing_unique_ids\n",
    "\n",
    "    def save_labels_to_file(self, label_idx):\n",
    "        \"\"\"Save labels to netCDF file with incremental updates\"\"\"\n",
    "\n",
    "        new_ds = xr.Dataset({\n",
    "            'unique_id': (['sample'], [self.unique_id]),\n",
    "            'datetime': (['sample'], [pd.to_datetime(self.datetime)]),\n",
    "            'y_idx': (['sample'], [self.scene_params['y_idx']]),\n",
    "            'x_idx': (['sample'], [self.scene_params['x_idx']]),\n",
    "            'lat_mid': (['sample'], [self.scene_params['lat_mid']]),\n",
    "            'lon_mid': (['sample'], [self.scene_params['lon_mid']]),\n",
    "            'ice_flag': (['sample'], [self.scene_params['ice_flag']]),\n",
    "            'label': (['sample'], [label_idx]),\n",
    "            'class_name': (['sample'], [self.class_names[label_idx]]),\n",
    "            'image_data': (['sample', 'channel', 'y', 'x'], [self.image_data])\n",
    "            }, \n",
    "            coords={'sample': [self.scene_params['image_idx']]}\n",
    "        )\n",
    "        \n",
    "        # Save or append to file\n",
    "        if os.path.exists(self.save_path):\n",
    "            # Load existing and concatenate\n",
    "            with xr.open_dataset(self.save_path) as existing_ds:\n",
    "                # Remove existing label for this image if it exists\n",
    "                if self.check_if_already_labeled():\n",
    "                    existing_ds.load()\n",
    "                    existing_ds = existing_ds.where(existing_ds.unique_id != self.unique_id, drop=True)\n",
    "\n",
    "                combined_ds = xr.concat([existing_ds, new_ds], dim='sample')\n",
    "                combined_ds.to_netcdf(self.save_path)\n",
    "        else:\n",
    "            # Save new file\n",
    "            new_ds.to_netcdf(self.save_path)\n",
    "            \n",
    "        print(f\"Saved new label to {self.save_path}\")\n",
    "    \n",
    "    def display_image_to_label(self, img_idx):\n",
    "        \"\"\"Display an image for labeling\"\"\"\n",
    "        fig, axes = plt.subplots(1, 4, figsize=(15, 5))\n",
    "        \n",
    "        idx = img_idx\n",
    "        current_image = self.image_data\n",
    "\n",
    "        # Display COD channel\n",
    "        axes[0].imshow(current_image[3], vmax=1, cmap='Greys_r')\n",
    "        axes[0].set_title('COD Channel')\n",
    "        axes[0].axis('off')\n",
    "        \n",
    "        # Display BT channel\n",
    "        axes[1].imshow(current_image[2], vmax=1, cmap='Greys')\n",
    "        axes[1].set_title('BT Ch14')\n",
    "        axes[1].axis('off')\n",
    "\n",
    "        # Display RGB composite\n",
    "        rgb_channels = current_image[0:3]\n",
    "        rgb_image = np.zeros((128, 128, 3))\n",
    "        for j in range(3):\n",
    "            ch = rgb_channels[j]\n",
    "            rgb_image[:, :, j] = ch\n",
    "        axes[2].imshow(rgb_image)\n",
    "        axes[2].set_title('RGB Composite')\n",
    "        axes[2].axis('off')\n",
    "\n",
    "        # Show zoomed out COD image for context\n",
    "        cod = self.cod\n",
    "        y_idx_not_zoomed = self.scene_params['y_idx']//2\n",
    "        x_idx_not_zoomed = self.scene_params['x_idx']//2\n",
    "        img_buffer = 300\n",
    "        \n",
    "        y_start = max(0, y_idx_not_zoomed - img_buffer)\n",
    "        y_end = min(cod.shape[0], y_idx_not_zoomed + img_buffer)\n",
    "        x_start = max(0, x_idx_not_zoomed - img_buffer)\n",
    "        x_end = min(cod.shape[1], x_idx_not_zoomed + img_buffer)\n",
    "        \n",
    "        axes[3].imshow(cod[y_start:y_end, x_start:x_end], vmax=40, vmin=0, cmap='Greys_r')\n",
    "        # plot box where image is\n",
    "        x_box = min(x_idx_not_zoomed-32, img_buffer-32)\n",
    "        y_box = min(y_idx_not_zoomed-32, img_buffer-32)\n",
    "        axes[3].plot([x_box, x_box + 64, x_box + 64, x_box, x_box],\n",
    "                     [y_box, y_box, y_box + 64, y_box + 64, y_box],\n",
    "                     color='red', linewidth=2)\n",
    "        axes[3].set_title('COD Context')\n",
    "        axes[3].axis('off')\n",
    "        \n",
    "        # Add title with location info\n",
    "        lat = self.scene_params['lat_mid']\n",
    "        lon = self.scene_params['lon_mid']\n",
    "        title = f\"Image #{idx}: Datetime {self.datetime}, Lat {lat:.1f}°, Lon {lon:.1f}°\"\n",
    "        \n",
    "        # Check if already labeled\n",
    "        existing_label = self.check_if_already_labeled()         \n",
    "        if existing_label:\n",
    "            title += f\"\\n[Current: {self.class_names[existing_label]}]\"\n",
    "            fig.patch.set_facecolor('lightgreen')\n",
    "        \n",
    "        fig.suptitle(title, fontsize=12)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        plt.close()\n",
    "        \n",
    "    def label_single_image(self, img_idx):\n",
    "        \"\"\"Label a single image interactively\"\"\"\n",
    "        self.display_image_to_label(img_idx)\n",
    "        \n",
    "        print(\"\\nClass options:\")\n",
    "        for i, class_name in enumerate(self.class_names):\n",
    "            print(f\"{i}: {class_name}\")\n",
    "        print(\"s: Skip image\")\n",
    "        print(\"d: delete label if exists\")\n",
    "        print(\"q: Quit labeling\")\n",
    "        \n",
    "        while True:\n",
    "            try:\n",
    "                user_input = input(f\"\\nEnter label for image {img_idx} (0-5 or 's'): \").strip()\n",
    "                \n",
    "                if user_input.lower() == 's':\n",
    "                    print(f\"Skipped image {img_idx}\")\n",
    "                    return True\n",
    "                \n",
    "                if user_input.lower() == 'q':\n",
    "                    print('\\nQuitting labeling process')\n",
    "                    return False\n",
    "                \n",
    "                if user_input.lower() == 'd':\n",
    "                    # Remove existing label for this image if it exists\n",
    "                    if os.path.exists(self.save_path):\n",
    "                        # Load existing and concatenate\n",
    "                        with xr.open_dataset(self.save_path) as existing_ds:\n",
    "                            # Remove existing label for this image if it exists\n",
    "                            if self.check_if_already_labeled():\n",
    "                                existing_ds.load()\n",
    "                                existing_ds = existing_ds.where(existing_ds.unique_id != self.unique_id, drop=True)\n",
    "                                existing_ds.to_netcdf(self.save_path)\n",
    "                                print(f\"Deleted existing label for image {img_idx}\")\n",
    "                                return True\n",
    "                            else:\n",
    "                                print(f\"No existing label to delete for image {img_idx}\")\n",
    "                                return True\n",
    "                    else:\n",
    "                        print(f\"No existing label to delete for image {img_idx}\")\n",
    "                        return True\n",
    "                \n",
    "                label_idx = int(user_input)\n",
    "                if 0 <= label_idx < len(self.class_names):\n",
    "                    \n",
    "                    print(f\"✓ Image {img_idx}: {self.class_names[label_idx]}\")\n",
    "                    self.save_labels_to_file(label_idx)\n",
    "                    return True\n",
    "                else:\n",
    "                    print(\"Invalid class number! Enter 0-5\")\n",
    "                    \n",
    "            except ValueError:\n",
    "                print(\"Invalid input! Enter number 0-5 or 's' or 'd' or 'q'\")\n",
    "\n",
    "def create_labeling_session(bt11, bt14, bt15, cod, n_samples=50, random_seed=42):\n",
    "    \"\"\"Create a labeling session with random samples from GOES data\"\"\"\n",
    "    np.random.seed(random_seed)\n",
    "    \n",
    "    # Preprocess data to get image patches\n",
    "    all_weirgb, scenes_params = preprocess_data(bt11, bt14, bt15, cod, window_size=128)\n",
    "    \n",
    "    # Select random samples\n",
    "    total_samples = len(all_weirgb)\n",
    "    if n_samples > total_samples:\n",
    "        n_samples = total_samples\n",
    "        \n",
    "    selected_indices = np.random.choice(total_samples, n_samples, replace=False)\n",
    "    selected_images = all_weirgb[selected_indices]\n",
    "    \n",
    "    # Update scene params for selected samples\n",
    "    selected_params = {}\n",
    "    for key in scenes_params.keys():\n",
    "        selected_params[key] = [scenes_params[key][i] for i in selected_indices]\n",
    "    \n",
    "    return selected_images, selected_params\n",
    "\n",
    "\n",
    "def start_non_interactive_labeling(bt11, bt14, bt15, cod, datetime, n_samples=20, random_seed=42, save_path=None):\n",
    "    \"\"\"Start non-interactive labeling session\"\"\"\n",
    "    class_names = ['Solid stratus', 'Closed MCC', 'Open MCC', 'Disorganized MCC', 'Clustered Cu', 'Suppressed Cu']\n",
    "    \n",
    "    print(\"Processing GOES data...\")\n",
    "    images, params = create_labeling_session(bt11, bt14, bt15, cod, n_samples, random_seed)\n",
    "    print(f\"Created {len(images)} image samples\")\n",
    "    \n",
    "    if save_path is None:\n",
    "        timestamp = pd.Timestamp.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "        save_path = f'goes_labels_{timestamp}.csv'\n",
    "    \n",
    "    print(f\"Labels will be saved to: {save_path}\")\n",
    "    \n",
    "    # Process images one by one\n",
    "    for img_idx in range(len(images)):\n",
    "        print(f\"\\n{'='*60}\")\n",
    "        print(f\"Image {img_idx + 1}/{len(images)}\")\n",
    "        print(f\"{'='*60}\")\n",
    "\n",
    "        params_idx = {key: params[key][img_idx] for key in params.keys()}\n",
    "        params_idx['image_idx'] = img_idx\n",
    "        labeler = SimpleGOESLabeler(images[img_idx], params_idx, datetime, cod, class_names, save_path)\n",
    "        status = labeler.label_single_image(img_idx)\n",
    "        if status is False:\n",
    "            break\n",
    "    \n",
    "    print(f\"\\nLabeling session complete! {len(images)} images labeled.\")\n",
    "    return labeler"
   ]
