    "dataset = GOESLabeledDataset(save_path)\n",
    "\n",
    "for i in np.random.choice(len(dataset), 5, replace=False):\n",
    "    image_tensor, label_tensor = dataset[i]  # Unpack the tuple correctly\n",
    "\n",
    "    # Add batch dimension since model expects batched input\n",
    "    image_tensor = image_tensor.unsqueeze(0).to(device)  # Shape: (1, 4, 128, 128)\n",
    "\n",
    "    # Now pass only the image tensor to the new model\n",
    "    outputs = fine_tuned_model(image_tensor)\n",
    "    _, predicted = torch.max(outputs.data, 1)\n",
    "\n",
    "    outputs_original = original_model(image_tensor)\n",
    "    _, predicted_original = torch.max(outputs_original.data, 1)\n",
    "\n",
    "    plt.imshow(image_tensor[0][3].cpu().numpy(), cmap='Greys_r')\n",
    "    plt.title(f\"Predicted: {predicted.item()}, Original judge: {predicted_original.item()}, True: {label_tensor.item()}\")\n",
    "    plt.axis('off')\n",
    "    print(outputs)\n",
    "    print(outputs_original)\n",
    "    plt.show()"
   ]
  },
